# Locust runtime defaults for smoke and continuous runs
LOCUST_SCENARIO=spike
LOCUST_DATASET_PATH=./dataset/continuous_run.jsonl
LOCUST_METRICS_PATH=./dataset/continuous_metrics.jsonl
LOCUST_METRICS_INTERVAL=30
LOCUST_LOG_SAMPLE_RATE=0.1
LOCUST_MAX_CREATIONS=200
LOCUST_SEED_ACCOUNTS=50
LOCUST_INVALID_PROB=0.02
# Other overrides can be set in environment or CLI
